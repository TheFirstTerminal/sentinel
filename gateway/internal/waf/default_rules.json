    "targets": [
      "path",
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "(?:;|\\||&&|\\$\\(|`)\\s*(?:getent|host|dig|nslookup|base64|xargs|perl|python[0-9.]*|php|ruby)\\s+\\S"
  },
  {
    "id": "CMDI-005",
