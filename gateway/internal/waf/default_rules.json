    "severity": 5,
    "targets": [
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "\\bon\\s+error\\s+resume\\s+next\\b"
  },
  {
    "id": "SSTI-003",
    "name": "Template expression probe with #{...} (Ruby, Java EL)",
    "category": "ssti",
    "severity": 5,
    "targets": [
      "path",
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "#\\{\\s*\\d+\\s*[*+]\\s*\\d+\\s*\\}|\\*\\{\\s*\\d+\\s*[*+]\\s*\\d+\\s*\\}"
  },
  {
    "id": "LFI-003",
    "name": "Windows network path to an admin share (\\\\host\\c$)",
    "category": "lfi",
    "severity": 5,
    "targets": [
      "path",
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "\\\\\\\\[a-z0-9._:-]+\\\\[a-z]\\$"
  },
  {
    "id": "LFI-004",
    "name": "Sensitive system file behind disguised or broken-encoded separators",
