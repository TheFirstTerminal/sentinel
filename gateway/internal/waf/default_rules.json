    "severity": 5,
    "targets": [
      "path",
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "(?i)(?:^|[^a-z0-9]|%u[0-9a-f]{4}|%[a-z0-9]{2}|0x(?:2f|5c))etc(?:[^a-z0-9\\s]|%u[0-9a-f]{4}|%[a-z0-9]{2}|0x(?:2f|5c))+(?:passwd|shadow|issue|hosts|group)(?:$|[^a-z0-9])|windows(?:[^a-z0-9\\s]|%u[0-9a-f]{4}|%[a-z0-9]{2}|0x(?:2f|5c))+system32(?:[^a-z0-9\\s]|%u[0-9a-f]{4}|%[a-z0-9]{2}|0x(?:2f|5c))+(?:drivers|config|cmd\\.exe)"
