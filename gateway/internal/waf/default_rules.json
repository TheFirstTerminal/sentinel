[
  {
    "id": "SQLI-001",
    "name": "UNION-based SQL injection",
    "category": "sqli",
    "severity": 5,
    "targets": [
      "path",
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "\\bunion\\b(?:\\s|#[^\\n]*\\n)+(?:all(?:\\s|#[^\\n]*\\n)+)?select\\b"
  },
  {
    "id": "SQLI-002",
    "name": "Boolean tautology after a quote (' OR 1=1)",
    "category": "sqli",
    "severity": 5,
    "targets": [
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "['\"`]\\s*(?:or|and|\\|\\||&&)\\s+(?:'[^']*'|\"[^\"]*\"|\\d+|true|false|[a-z_]+)\\s*(?:=|<|>|like\\b|is\\b)"
  },
  {
    "id": "SQLI-003",
    "name": "Quote followed by SQL comment (admin'--)",
    "category": "sqli",
    "severity": 5,
    "targets": [
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "['\"`]\\s*\\)*\\s*(?:--|/\\*)"
  },
  {
    "id": "SQLI-007",
    "name": "Quote followed by MySQL # comment",
    "category": "sqli",
    "severity": 3,
    "targets": [
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "['`]\\s*\\)*\\s*#"
  },
  {
    "id": "SQLI-008",
    "name": "Conditional expression for blind SQL injection (CASE WHEN ... THEN)",
    "category": "sqli",
    "severity": 3,
    "targets": [
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "\\bcase\\s+when\\b.{1,120}?\\bthen\\b"
  },
  {
    "id": "SQLI-009",
    "name": "Quoted comparison used as a probe (AND 'abc'='abc)",
    "category": "sqli",
    "severity": 5,
    "targets": [
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "\\b(?:and|or)\\s+['\"][^'\"]{0,30}['\"]?\\s*=\\s*['\"]"
  },
  {
    "id": "SQLI-010",
    "name": "BETWEEN comparison after a quote",
    "category": "sqli",
    "severity": 5,
    "targets": [
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "['\"`]\\s*\\)*\\s*(?:and|or|&&|\\|\\|)\\s+\\S+\\s+(?:not\\s+)?between\\s+\\S+\\s+and\\b"
  },
  {
    "id": "SQLI-011",
    "name": "String built from character codes (CHAR(65,66,...))",
    "category": "sqli",
    "severity": 3,
    "targets": [
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "\\b(?:char|chr|nchar)\\s*\\(\\s*\\d+\\s*(?:,\\s*\\d+\\s*){2,}\\)"
  },
  {
    "id": "SQLI-012",
    "name": "Always-true condition without quotes (AND 1=1, OR x=y#)",
    "category": "sqli",
    "severity": 5,
    "targets": [
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "(?:^|[\\s)])(?:and|or)\\s+(?:\\d+\\s*=\\s*\\d+\\b|[a-z_]\\w*\\s*=\\s*[a-z_]\\w*\\s*(?:#|--))"
  },
  {
    "id": "SQLI-004",
    "name": "Stacked query with destructive statement",
    "category": "sqli",
    "severity": 5,
    "targets": [
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": ";\\s*(?:drop|delete|insert|update|alter|create|truncate|exec|shutdown)\\b"
  },
  {
    "id": "SQLI-005",
    "name": "Time-based blind SQL injection",
    "category": "sqli",
    "severity": 5,
    "targets": [
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "\\b(?:sleep|benchmark|pg_sleep)\\s*\\(|\\bwaitfor\\s+delay\\b"
  },
  {
    "id": "SQLI-006",
    "name": "Database metadata access",
    "category": "sqli",
    "severity": 5,
    "targets": [
      "query",
      "body",
      "cookies",
      "headers"
    ],
    "pattern": "\\b(?:information_schema|sqlite_master|pg_catalog|mysql\\.user|xp_cmdshell|sysibm|syscat)\\b"
  },
  {
    "id": "XSS-001",
