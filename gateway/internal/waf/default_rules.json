  {
    "id": "XXE-002",
    "name": "XML declared as UTF-7 (hides markup from filters)",
    "category": "xxe",
    "severity": 5,
    "targets": [
      "path",
      "body",
      "query"
    ],
    "pattern": "<\\?xml[^>]{0,100}encoding\\s*=\\s*[\\\"']utf-7"
  }
