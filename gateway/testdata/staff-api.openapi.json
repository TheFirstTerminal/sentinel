{
  "openapi": "3.0.3",
  "info": {
    "title": "Staff API",
    "version": "1.0.0",
    "description": "Internal employee directory. Sentinel only lets through requests that match this specification."
  },
  "components": {
    "schemas": {
      "Username": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,19}$"
      }
    }
  },
  "paths": {
    "/staff/api/health": {
      "get": {
        "summary": "Health check"
      }
    },
    "/staff/api/employees/{username}": {
      "parameters": [
        {
          "name": "username",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Username"
          }
        }
      ],
      "get": {
        "summary": "View an employee profile"
      },
      "put": {
        "summary": "Update your contact details",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 100
                  },
                  "phone": {
                    "type": "string",
                    "pattern": "^\\+?[0-9 ]{7,20}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/staff/api/employees/{username}/salary": {
      "parameters": [
        {
          "name": "username",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Username"
          }
        }
      ],
      "get": {
        "summary": "View a salary"
      }
    },
    "/staff/api/admin/employees": {
      "get": {
        "summary": "List all employees",
        "parameters": [
          {
            "name": "department",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "hr",
                "sales",
                "engineering",
                "it"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ]
      }
    },
    "/staff/api/admin/employees/{username}": {
      "parameters": [
        {
          "name": "username",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Username"
          }
        }
      ],
      "delete": {
        "summary": "Remove an employee"
      }
    },
    "/staff/api/admin/payroll-export": {
      "get": {
        "summary": "Export payroll as CSV"
      }
    },
    "/staff/api/internal/payroll-sync": {
      "get": {
        "summary": "Payroll sync for the payroll service (machine to machine)"
      }
    },
    "/staff/api/assistant": {
      "post": {
        "summary": "Ask the HR assistant (simulated AI chatbot)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
