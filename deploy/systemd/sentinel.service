# Sentinel as a system service (Linux, no Docker).
#
#   sudo useradd --system --home /var/lib/sentinel --create-home sentinel
#   sudo install -m 755 sentinel /usr/local/bin/sentinel
#   sudo mkdir -p /etc/sentinel && sudo sentinel init /etc/sentinel/sentinel.yaml
#   (set upstream: in that file)
#   sudo cp sentinel.service /etc/systemd/system/ && sudo systemctl enable --now sentinel
#   journalctl -u sentinel | grep "FIRST RUN"      # the link to create the admin
#
# Reload rules, exclusions and policy without a restart: systemctl reload sentinel

[Unit]
Description=Sentinel security gateway
After=network-online.target
Wants=network-online.target

[Service]
User=sentinel
ExecStart=/usr/local/bin/sentinel -config /etc/sentinel/sentinel.yaml
ExecReload=/bin/kill -HUP $MAINPID
Environment=DATA_DIR=/var/lib/sentinel
Restart=on-failure
# Bind ports 80/443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sentinel
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
